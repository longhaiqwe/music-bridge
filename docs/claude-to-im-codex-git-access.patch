     const CodexClass = this.sdk.Codex;
     this.codex = new CodexClass({
       ...(apiKey ? { apiKey } : {}),
       ...(baseUrl ? { baseUrl } : {}),
+      ...(config ? { config } : {}),
     });
 
     return { sdk: this.sdk, codex: this.codex };
