diff --git a/src/codex-provider.ts b/src/codex-provider.ts
index 8d4f4d1..c176aba 100644
--- a/src/codex-provider.ts
+++ b/src/codex-provider.ts
@@ -49,6 +49,27 @@ function shouldPassModelToCodex(): boolean {
   return process.env.CTI_CODEX_PASS_MODEL === 'true';
 }
 
+function shouldSkipGitRepoCheck(): boolean {
+  return process.env.CTI_CODEX_SKIP_GIT_REPO_CHECK === 'true';
+}
+
+function readCodexConfigOverride(): Record<string, unknown> | undefined {
+  const raw = process.env.CTI_CODEX_CONFIG_JSON?.trim();
+  if (!raw) return undefined;
+
+  try {
+    const parsed = JSON.parse(raw);
+    if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+      return parsed as Record<string, unknown>;
+    }
+    console.warn('[codex-provider] CTI_CODEX_CONFIG_JSON must be a JSON object; ignoring override');
+  } catch (error) {
+    const message = error instanceof Error ? error.message : String(error);
+    console.warn(`[codex-provider] Failed to parse CTI_CODEX_CONFIG_JSON: ${message}`);
+  }
+
+  return undefined;
+}
+
 function looksLikeClaudeModel(model?: string): boolean {
   return !!model && /^claude[-_]/i.test(model);
 }
